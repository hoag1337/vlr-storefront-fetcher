# Copy to .env and fill in. NEVER commit .env.

# From @BotFather.
TELEGRAM_TOKEN=

# Both printed by: python gen_keys.py
BOT_PRIVATE_KEY=
AT_REST_KEY=

# OPTIONAL. Not an allowlist — anyone can use the bot. This is only who may run
# the owner commands (/lockdown, /unlock). Get your id from @userinfobot.
OWNER_ID=

# OPTIONAL. Defaults shown.
DB_PATH=data/valstore.db
# The in-browser sealing page (the docs/ folder on GitHub Pages). Override if
# you host it somewhere else.
LINK_PAGE_URL=https://hoag1337.github.io/vlr-storefront-fetcher/
MAX_ACCOUNTS_PER_USER=5
LINK_ATTEMPTS_PER_HOUR=10
GLOBAL_LINK_ATTEMPTS_PER_HOUR=100
# How often (seconds) the background sweep checks wishlists against the shop.
# The shop only rotates about once a day, and adding a skin triggers its own
# immediate check, so this just catches rotations nobody was around to see.
WISHLIST_POLL_INTERVAL_SECONDS=86400
MAX_WISHLIST_ITEMS_PER_USER=25
